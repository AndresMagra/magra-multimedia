---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import DiagnosticoDialog from '../components/DiagnosticoDialog.astro';
import { url } from '../config';
---

<Base title="Página no encontrada — Magra MultiMedia" description="Esta página no existe." noindex>
  <Nav />

  <main class="section nf">
    <div class="wrap">
      <p class="eyebrow">404</p>
      <h1 class="nf__title">Esta página no existe.</h1>
      <p class="lead">This page doesn't exist.</p>
      <div class="nf__actions">
        <a class="btn" href={url('/')}>Ir al inicio</a>
        <a class="btn btn--ghost" href={url('/en/')} hreflang="en" lang="en">Go to the English site</a>
      </div>
    </div>
  </main>

  <Footer />
  <DiagnosticoDialog />
</Base>

<style>
  .nf {
    padding-block-start: calc(72px + var(--section-y));
    min-height: 70vh;
  }

  .nf__title {
    font-size: var(--fs-h2);
    margin-block-end: 1rem;
  }

  .nf__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-block-start: 2rem;
  }
</style>
