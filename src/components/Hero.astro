---
import { url } from '../config';

// The gold loop is texture, not proof — the headline says what we do, the
// footage says what tier we're in. Poster must look finished on its own
// because iOS in-app browsers routinely block autoplay.
---

<section class="hero">
  <div class="hero__media" aria-hidden="true">
    <video
      class="hero__video"
      src={url("/video/hero-loop.mp4")}
      poster={url("/img/hero-poster.jpg")}
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
    ></video>
    <div class="hero__scrim"></div>
  </div>

  <div class="wrap hero__inner">
    <!-- Hero entrance is pure CSS, not the JS reveal: this content is above the
         fold and must never depend on a script to become visible. -->
    <h1 class="hero__title hero-in hero-in--lcp">
      Todos publican.<br /><span class="gold-text">Pocos venden.</span>
    </h1>

    <p class="hero__lead lead hero-in" style="--i:1">
      Video, sitios web y campañas publicitarias para negocios que ya venden y quieren vender
      más. Herramientas de última generación, con una persona real detrás de cada proyecto.
    </p>

    <div class="hero__actions hero-in" style="--i:2">
      <button class="btn" type="button" data-open-diagnostico data-source="hero">
        Pedir mi diagnóstico
      </button>
      <a class="btn btn--ghost" href={url("/#servicios")}>Ver servicios</a>
    </div>

    <p class="hero__micro hero-in" style="--i:3">
      Sin costo ni compromiso <span class="sep">·</span> Respuesta el mismo día
    </p>
  </div>

  <div class="hero__cue" aria-hidden="true"><span></span></div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    overflow: hidden;
    padding-block: 8rem 5rem;
  }

  .hero__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Composition is bottom-heavy; bias the crop so the gold stays visible
       when a phone crops the 16:9 source to portrait. */
    object-position: 60% 55%;
  }

  /* The scrim guarantees text contrast regardless of what the footage does,
     which is what lets the video be chosen for beauty rather than negative space. */
  .hero__scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(11, 11, 12, 0.86) 0%, rgba(11, 11, 12, 0.42) 42%, rgba(11, 11, 12, 0.94) 100%),
      linear-gradient(90deg, rgba(11, 11, 12, 0.8) 0%, rgba(11, 11, 12, 0.15) 70%);
  }

  .hero__inner {
    position: relative;
    z-index: 1;
  }

  .hero__title {
    font-size: var(--fs-hero);
    margin-block-end: 1.6rem;
  }

  .hero__lead {
    max-width: 46ch;
    margin-block-end: 2.6rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-block-end: 1.4rem;
  }

  .hero__micro {
    font-size: var(--fs-micro);
    letter-spacing: 0.06em;
    color: var(--text-faint);
    text-transform: uppercase;
  }

  .hero__micro .sep {
    color: var(--gold);
    margin-inline: 0.4rem;
  }

  .hero__cue {
    position: absolute;
    inset-block-end: 2.2rem;
    inset-inline-start: 50%;
    translate: -50% 0;
    z-index: 1;
    width: 1px;
    height: 54px;
    background: var(--line);
    overflow: hidden;
  }

  .hero__cue span {
    position: absolute;
    inset-inline: 0;
    height: 40%;
    background: var(--gold-light);
    animation: cue 2.6s var(--ease) infinite;
  }

  @keyframes cue {
    0% { transform: translateY(-100%); opacity: 0; }
    35% { opacity: 1; }
    100% { transform: translateY(250%); opacity: 0; }
  }

  @media (max-width: 640px) {
    .hero__actions .btn {
      width: 100%;
    }
    .hero__cue {
      display: none;
    }
  }
</style>
