---
import { getLang } from '../i18n';

const lang = getLang(Astro.url);
const en = lang === 'en';

const servicios = en
  ? [
      {
        n: '01',
        titulo: 'Video and ads',
        texto: 'Ready-to-publish pieces that stop the scroll and sell. Produced in days, not months.',
        precios: ['Ad video from RD$15,000'],
        cta: 'Talk about video',
        source: 'servicio_video',
      },
      {
        n: '02',
        titulo: 'Websites',
        texto: 'Fast, elegant sites built to turn visits into conversations. No templates.',
        precios: [
          'Landing page from RD$30,000',
          'Business site (5-8 pages) from RD$60,000',
          'Maintenance plan from RD$3,000/month',
        ],
        cta: 'Talk about my site',
        source: 'servicio_web',
      },
      {
        n: '03',
        titulo: 'Ad campaigns',
        texto: 'Google, Meta and Instagram. Management, tracking and optimization with clear numbers every month.',
        precios: ['Meta ads management from RD$15,000/month'],
        nota: 'You pay the ad spend directly to Meta.',
        cta: 'Talk about campaigns',
        source: 'servicio_campanas',
      },
    ]
  : [
      {
        n: '01',
        titulo: 'Video y anuncios',
        texto: 'Piezas listas para publicar que detienen el scroll y venden. Producción en días, no en meses.',
        precios: ['Video de anuncio desde RD$15,000'],
        cta: 'Hablar de video',
        source: 'servicio_video',
      },
      {
        n: '02',
        titulo: 'Sitios web',
        texto: 'Sitios rápidos, elegantes y construidos para convertir visitas en conversaciones. Nada de plantillas.',
        precios: [
          'Página de aterrizaje desde RD$30,000',
          'Sitio de negocio (5-8 páginas) desde RD$60,000',
          'Plan de mantenimiento desde RD$3,000/mes',
        ],
        cta: 'Hablar de mi sitio',
        source: 'servicio_web',
      },
      {
        n: '03',
        titulo: 'Campañas publicitarias',
        texto: 'Google, Meta e Instagram. Gestión, medición y optimización con números claros cada mes.',
        precios: ['Manejo de anuncios en Meta desde RD$15,000/mes'],
        nota: 'La inversión publicitaria la pagas tú directamente a Meta.',
        cta: 'Hablar de campañas',
        source: 'servicio_campanas',
      },
    ];

const t = en
  ? { eyebrow: 'What I do', h2: 'Three pieces. One strategy.' }
  : { eyebrow: 'Qué hago', h2: 'Tres piezas. Una sola estrategia.' };
---

<section class="section servicios" id="servicios">
  <div class="wrap">
    <p class="eyebrow reveal">{t.eyebrow}</p>
    <h2 class="servicios__title reveal" style="--i:1">{t.h2}</h2>

    <div class="servicios__grid">
      {
        servicios.map((s, i) => (
          <article class="card reveal" style={`--i:${i + 2}`}>
            <span class="card__n">{s.n}</span>
            <h3 class="card__title">{s.titulo}</h3>
            <p class="card__text">{s.texto}</p>
            <ul class="card__precios">
              {s.precios.map((pr) => <li>{pr}</li>)}
            </ul>
            {s.nota && <p class="card__nota">{s.nota}</p>}
            <button class="card__cta" type="button" data-open-diagnostico data-source={s.source}>
              {s.cta}
              <span class="card__arrow" aria-hidden="true">&rarr;</span>
            </button>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .servicios__title {
    font-size: var(--fs-h2);
    margin-block-end: clamp(2.5rem, 6vw, 4rem);
  }

  .servicios__grid {
    display: grid;
    gap: 1px;
    background: var(--line-soft);
    border: 1px solid var(--line-soft);
  }

  .card {
    background: var(--bg);
    padding: clamp(1.75rem, 4vw, 2.75rem);
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    transition: background 0.6s var(--ease);
    position: relative;
    overflow: hidden;
  }

  .card::before {
    /* Gold hairline that draws in on hover. */
    content: '';
    position: absolute;
    inset-block-start: 0;
    inset-inline: 0;
    height: 1px;
    background: var(--gold-grad);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.7s var(--ease-out);
  }

  .card:hover {
    background: var(--bg-elev);
  }

  .card:hover::before {
    transform: scaleX(1);
  }

  .card__n {
    font-family: var(--font-display);
    font-size: var(--fs-small);
    letter-spacing: 0.14em;
    color: var(--gold);
  }

  .card__title {
    font-size: var(--fs-h3);
  }

  .card__text {
    color: var(--text-dim);
    font-size: var(--fs-body);
    flex: 1;
  }

  .card__precios {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.35rem;
    color: var(--gold-light);
    font-size: var(--fs-small);
    font-weight: 500;
  }

  .card__nota {
    color: var(--text-dim);
    font-size: var(--fs-small);
    margin: 0;
  }

  .card__cta {
    align-self: flex-start;
    background: none;
    border: 0;
    padding: 0;
    margin-block-start: 0.6rem;
    color: var(--gold-light);
    font-family: var(--font-body);
    font-size: var(--fs-small);
    font-weight: 500;
    letter-spacing: 0.03em;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
  }

  .card__arrow {
    transition: transform 0.5s var(--ease-out);
  }

  .card__cta:hover .card__arrow {
    transform: translateX(5px);
  }

  @media (min-width: 900px) {
    .servicios__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
