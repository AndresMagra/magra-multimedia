---
const servicios = [
  {
    n: '01',
    titulo: 'Video y anuncios',
    texto:
      'Piezas listas para publicar que detienen el scroll y venden. Producción en días, no en meses.',
    cta: 'Hablar de video',
    source: 'servicio_video',
  },
  {
    n: '02',
    titulo: 'Sitios web',
    texto:
      'Sitios rápidos, elegantes y construidos para convertir visitas en conversaciones. Nada de plantillas.',
    cta: 'Hablar de mi sitio',
    source: 'servicio_web',
  },
  {
    n: '03',
    titulo: 'Campañas publicitarias',
    texto:
      'Google, Meta e Instagram. Gestión, medición y optimización con números claros cada mes.',
    cta: 'Hablar de campañas',
    source: 'servicio_campanas',
  },
];
---

<section class="section servicios" id="servicios">
  <div class="wrap">
    <p class="eyebrow reveal">Qué hago</p>
    <h2 class="servicios__title reveal" style="--i:1">Tres piezas. Una sola estrategia.</h2>

    <div class="servicios__grid">
      {
        servicios.map((s, i) => (
          <article class="card reveal" style={`--i:${i + 2}`}>
            <span class="card__n">{s.n}</span>
            <h3 class="card__title">{s.titulo}</h3>
            <p class="card__text">{s.texto}</p>
            <button class="card__cta" type="button" data-open-diagnostico data-source={s.source}>
              {s.cta}
              <span class="card__arrow" aria-hidden="true">&rarr;</span>
            </button>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .servicios__title {
    font-size: var(--fs-h2);
    margin-block-end: clamp(2.5rem, 6vw, 4rem);
  }

  .servicios__grid {
    display: grid;
    gap: 1px;
    background: var(--line-soft);
    border: 1px solid var(--line-soft);
  }

  .card {
    background: var(--bg);
    padding: clamp(1.75rem, 4vw, 2.75rem);
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    transition: background 0.6s var(--ease);
    position: relative;
    overflow: hidden;
  }

  .card::before {
    /* Gold hairline that draws in on hover. */
    content: '';
    position: absolute;
    inset-block-start: 0;
    inset-inline: 0;
    height: 1px;
    background: var(--gold-grad);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.7s var(--ease-out);
  }

  .card:hover {
    background: var(--bg-elev);
  }

  .card:hover::before {
    transform: scaleX(1);
  }

  .card__n {
    font-family: var(--font-display);
    font-size: var(--fs-small);
    letter-spacing: 0.14em;
    color: var(--gold);
  }

  .card__title {
    font-size: var(--fs-h3);
  }

  .card__text {
    color: var(--text-dim);
    font-size: var(--fs-body);
    flex: 1;
  }

  .card__cta {
    align-self: flex-start;
    background: none;
    border: 0;
    padding: 0;
    margin-block-start: 0.6rem;
    color: var(--gold-light);
    font-family: var(--font-body);
    font-size: var(--fs-small);
    font-weight: 500;
    letter-spacing: 0.03em;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
  }

  .card__arrow {
    transition: transform 0.5s var(--ease-out);
  }

  .card__cta:hover .card__arrow {
    transform: translateX(5px);
  }

  @media (min-width: 900px) {
    .servicios__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
