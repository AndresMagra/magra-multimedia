---
// Mobile only. Most traffic arrives in the Instagram/Facebook in-app browser,
// where the nav CTA is hidden — this keeps the conversion path one thumb away
// at every scroll position.
import { getLang } from '../i18n';
const label = getLang(Astro.url) === 'en' ? 'Get my diagnostic' : 'Pedir mi diagnóstico';
---

<div class="sticky" id="sticky-bar" hidden>
  <button class="btn sticky__btn" type="button" data-open-diagnostico data-source="sticky">
    {label}
  </button>
</div>

<style>
  .sticky {
    position: fixed;
    inset-inline: 0;
    inset-block-end: 0;
    z-index: 50;
    padding: 0.75rem var(--gutter) calc(0.75rem + env(safe-area-inset-bottom, 0px));
    background: rgba(11, 11, 12, 0.9);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    border-block-start: 1px solid var(--line-soft);
    transform: translateY(110%);
    transition: transform 0.6s var(--ease-out);
  }

  .sticky.is-visible {
    transform: none;
  }

  /* Wins over .is-visible so the bar drops away while the dialog is open. */
  .sticky.is-visible.is-hidden {
    transform: translateY(110%);
  }

  .sticky__btn {
    width: 100%;
  }

  @media (min-width: 900px) {
    .sticky {
      display: none;
    }
  }
</style>

<script>
  const bar = document.getElementById('sticky-bar');
  // Home has .hero; inner pages use their first section as the trigger, so the
  // mobile CTA is reachable on every page (the nav CTA is hidden on phones).
  const hero = document.querySelector('.hero') ?? document.querySelector('main .section');

  if (bar && hero) {
    bar.hidden = false;

    // Appear once the hero (which has its own CTA) is scrolled past.
    const io = new IntersectionObserver(
      ([entry]) => bar.classList.toggle('is-visible', !entry.isIntersecting),
      { threshold: 0, rootMargin: '-70% 0px 0px 0px' },
    );
    io.observe(hero);

    // Hide it while the dialog is open so it doesn't sit on top of the panel.
    const dialog = document.getElementById('diagnostico');
    dialog?.addEventListener('close', () => bar.classList.remove('is-hidden'));
    document.querySelectorAll('[data-open-diagnostico]').forEach((btn) =>
      btn.addEventListener('click', () => bar.classList.add('is-hidden')),
    );
  }
</script>
