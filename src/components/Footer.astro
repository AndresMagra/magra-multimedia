---
import { SITE } from '../config';
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="wrap footer__inner">
    <div class="footer__brand">
      <span class="footer__mark" aria-hidden="true">MM</span>
      <p class="footer__name">Magra <em>MultiMedia</em></p>
      <p class="footer__tag">{SITE.tagline}</p>
      <p class="footer__geo">Latinoamérica · Trabajo remoto</p>
    </div>

    <nav class="footer__nav" aria-label="Pie de página">
      <a href="#servicios">Servicios</a>
      <a href="#proceso">Proceso</a>
      <a href="#por-que">Por qué</a>
      <a href="#faq">Preguntas</a>
      <a href="/privacidad">Privacidad</a>
    </nav>
  </div>

  <div class="wrap footer__base">
    <p>&copy; {year} {SITE.name}</p>
    <button class="footer__cta" type="button" data-open-diagnostico data-source="footer">
      Pedir diagnóstico &rarr;
    </button>
  </div>
</footer>

<style>
  .footer {
    border-block-start: 1px solid var(--line-soft);
    padding-block-start: clamp(3rem, 7vw, 5rem);
    /* Room for the sticky mobile bar. */
    padding-block-end: calc(2rem + env(safe-area-inset-bottom, 0px) + 76px);
  }

  .footer__inner {
    display: grid;
    gap: 2.5rem;
    padding-block-end: 2.5rem;
  }

  .footer__mark {
    font-family: var(--font-display);
    font-size: 1.7rem;
    font-weight: 600;
    letter-spacing: -0.06em;
    background: var(--gold-grad);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .footer__name {
    font-family: var(--font-display);
    font-size: 1.15rem;
    margin-block: 0.4rem 0.5rem;
  }

  .footer__name em {
    font-style: normal;
    color: var(--gold-light);
  }

  .footer__tag,
  .footer__geo {
    color: var(--text-faint);
    font-size: var(--fs-micro);
    margin: 0;
  }

  .footer__geo {
    margin-block-start: 0.3rem;
  }

  .footer__nav {
    display: grid;
    gap: 0.75rem;
    font-size: var(--fs-small);
    color: var(--text-dim);
    align-content: start;
  }

  .footer__nav a:hover {
    color: var(--gold-light);
  }

  .footer__base {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding-block-start: 1.6rem;
    border-block-start: 1px solid var(--line-soft);
    font-size: var(--fs-micro);
    color: var(--text-faint);
  }

  .footer__base p {
    margin: 0;
  }

  .footer__cta {
    background: none;
    border: 0;
    padding: 0;
    color: var(--gold-light);
    font-family: var(--font-body);
    font-size: var(--fs-micro);
    cursor: pointer;
  }

  @media (min-width: 760px) {
    .footer__inner {
      grid-template-columns: 1.4fr 1fr;
    }
    .footer__nav {
      grid-template-columns: repeat(2, max-content);
      gap: 0.75rem 3rem;
      justify-content: end;
    }
  }

  @media (min-width: 900px) {
    .footer {
      padding-block-end: 2.5rem;
    }
  }
</style>
