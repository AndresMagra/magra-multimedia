---
import { SITE } from '../config';
import { getLang, href } from '../i18n';

const year = new Date().getFullYear();
const lang = getLang(Astro.url);
const en = lang === 'en';
const t = en
  ? {
      tag: 'Video · Websites · Ad campaigns',
      geo: 'Latin America & US · Remote work',
      nav: 'Footer',
      links: [
        ['Services', href(lang, '/', '#servicios')],
        ['Process', href(lang, '/', '#proceso')],
        ['Why me', href(lang, '/', '#por-que')],
        ['FAQ', href(lang, '/', '#faq')],
        ['Video and ads', href(lang, '/servicios/video-y-anuncios')],
        ['Diagnostic', href(lang, '/diagnostico')],
        ['Privacy', href(lang, '/privacidad')],
      ],
      cta: 'Get my diagnostic',
    }
  : {
      tag: SITE.tagline,
      geo: 'Latinoamérica · Trabajo remoto',
      nav: 'Pie de página',
      links: [
        ['Servicios', href(lang, '/', '#servicios')],
        ['Proceso', href(lang, '/', '#proceso')],
        ['Por qué', href(lang, '/', '#por-que')],
        ['Preguntas', href(lang, '/', '#faq')],
        ['Video y anuncios', href(lang, '/servicios/video-y-anuncios')],
        ['Diagnóstico', href(lang, '/diagnostico')],
        ['Privacidad', href(lang, '/privacidad')],
      ],
      cta: 'Pedir diagnóstico',
    };
---

<footer class="footer">
  <div class="wrap footer__inner">
    <div class="footer__brand">
      <span class="footer__mark" aria-hidden="true">MM</span>
      <p class="footer__name">Magra <em>MultiMedia</em></p>
      <p class="footer__tag">{t.tag}</p>
      <p class="footer__geo">{t.geo}</p>
    </div>

    <nav class="footer__nav" aria-label={t.nav}>
      {t.links.map(([label, link]) => <a href={link}>{label}</a>)}
    </nav>
  </div>

  <div class="wrap footer__base">
    <p>&copy; {year} {SITE.name}</p>
    <button class="footer__cta" type="button" data-open-diagnostico data-source="footer">
      {t.cta} &rarr;
    </button>
  </div>
</footer>

<style>
  .footer {
    border-block-start: 1px solid var(--line-soft);
    padding-block-start: clamp(3rem, 7vw, 5rem);
    /* Room for the sticky mobile bar. */
    padding-block-end: calc(2rem + env(safe-area-inset-bottom, 0px) + 76px);
  }

  .footer__inner {
    display: grid;
    gap: 2.5rem;
    padding-block-end: 2.5rem;
  }

  .footer__mark {
    font-family: var(--font-display);
    font-size: 1.7rem;
    font-weight: 600;
    letter-spacing: -0.06em;
    background: var(--gold-grad);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .footer__name {
    font-family: var(--font-display);
    font-size: 1.15rem;
    margin-block: 0.4rem 0.5rem;
  }

  .footer__name em {
    font-style: normal;
    color: var(--gold-light);
  }

  .footer__tag,
  .footer__geo {
    color: var(--text-faint);
    font-size: var(--fs-micro);
    margin: 0;
  }

  .footer__geo {
    margin-block-start: 0.3rem;
  }

  .footer__nav {
    display: grid;
    gap: 0.75rem;
    font-size: var(--fs-small);
    color: var(--text-dim);
    align-content: start;
  }

  .footer__nav a:hover {
    color: var(--gold-light);
  }

  .footer__base {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding-block-start: 1.6rem;
    border-block-start: 1px solid var(--line-soft);
    font-size: var(--fs-micro);
    color: var(--text-faint);
  }

  .footer__base p {
    margin: 0;
  }

  .footer__cta {
    background: none;
    border: 0;
    padding: 0;
    color: var(--gold-light);
    font-family: var(--font-body);
    font-size: var(--fs-micro);
    cursor: pointer;
  }

  @media (min-width: 760px) {
    .footer__inner {
      grid-template-columns: 1.4fr 1fr;
    }
    .footer__nav {
      grid-template-columns: repeat(2, max-content);
      gap: 0.75rem 3rem;
      justify-content: end;
    }
  }

  @media (min-width: 900px) {
    .footer {
      padding-block-end: 2.5rem;
    }
  }
</style>
