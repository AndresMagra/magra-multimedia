---
import { getLang } from '../i18n';

const lang = getLang(Astro.url);
const t =
  lang === 'en'
    ? {
        eyebrow: 'The problem',
        h2a: "Your business doesn't have",
        h2b: 'a product problem.',
        lead: 'It has a problem with how it looks, where it shows up and what it says when someone finally finds it.',
        dolores: [
          "You post often, but sales don't move.",
          "You pay for ads and don't know for sure what's working.",
          'Your competition looks better than you, even if your product is better.',
        ],
      }
    : {
        eyebrow: 'El problema',
        h2a: 'Tu negocio no tiene',
        h2b: 'un problema de producto.',
        lead: 'Tiene un problema de cómo se ve, dónde aparece y qué dice cuando alguien finalmente lo encuentra.',
        dolores: [
          'Publicas seguido, pero las ventas no se mueven.',
          'Pagas anuncios y no sabes con certeza qué está funcionando.',
          'Tu competencia se ve mejor que tú, aunque tu producto sea superior.',
        ],
      };
---

<section class="section problema" id="problema">
  <div class="wrap">
    <p class="eyebrow reveal">{t.eyebrow}</p>
    <h2 class="problema__title reveal" style="--i:1">
      {t.h2a}<br />{t.h2b}
    </h2>
    <p class="lead prose reveal" style="--i:2">{t.lead}</p>

    <ul class="problema__list">
      {
        t.dolores.map((d, i) => (
          <li class="problema__item reveal" style={`--i:${i + 3}`}>
            <span class="problema__num">{String(i + 1).padStart(2, '0')}</span>
            <span>{d}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .problema__title {
    font-size: var(--fs-h2);
    margin-block-end: 1.4rem;
  }

  .problema__list {
    list-style: none;
    padding: 0;
    margin: clamp(3rem, 7vw, 5rem) 0 0;
    display: grid;
    gap: 0;
    border-block-start: 1px solid var(--line-soft);
  }

  .problema__item {
    display: flex;
    align-items: baseline;
    gap: clamp(1rem, 4vw, 2.5rem);
    padding-block: clamp(1.4rem, 3vw, 2rem);
    border-block-end: 1px solid var(--line-soft);
    font-size: var(--fs-lead);
    color: var(--text-dim);
  }

  .problema__num {
    font-family: var(--font-display);
    font-size: var(--fs-small);
    color: var(--gold);
    flex-shrink: 0;
    letter-spacing: 0.1em;
  }
</style>
