---
const dolores = [
  'Publicas seguido, pero las ventas no se mueven.',
  'Pagas anuncios y no sabes con certeza qué está funcionando.',
  'Tu competencia se ve mejor que tú, aunque tu producto sea superior.',
];
---

<section class="section problema" id="problema">
  <div class="wrap">
    <p class="eyebrow reveal">El problema</p>
    <h2 class="problema__title reveal" style="--i:1">
      Tu negocio no tiene<br />un problema de producto.
    </h2>
    <p class="lead prose reveal" style="--i:2">
      Tiene un problema de cómo se ve, dónde aparece y qué dice cuando alguien finalmente lo
      encuentra.
    </p>

    <ul class="problema__list">
      {
        dolores.map((d, i) => (
          <li class="problema__item reveal" style={`--i:${i + 3}`}>
            <span class="problema__num">{String(i + 1).padStart(2, '0')}</span>
            <span>{d}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .problema__title {
    font-size: var(--fs-h2);
    margin-block-end: 1.4rem;
  }

  .problema__list {
    list-style: none;
    padding: 0;
    margin: clamp(3rem, 7vw, 5rem) 0 0;
    display: grid;
    gap: 0;
    border-block-start: 1px solid var(--line-soft);
  }

  .problema__item {
    display: flex;
    align-items: baseline;
    gap: clamp(1rem, 4vw, 2.5rem);
    padding-block: clamp(1.4rem, 3vw, 2rem);
    border-block-end: 1px solid var(--line-soft);
    font-size: var(--fs-lead);
    color: var(--text-dim);
  }

  .problema__num {
    font-family: var(--font-display);
    font-size: var(--fs-small);
    color: var(--gold);
    flex-shrink: 0;
    letter-spacing: 0.1em;
  }
</style>
