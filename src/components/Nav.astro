---
import { SITE } from '../config';
import { getLang, href, alternates } from '../i18n';

const lang = getLang(Astro.url);
const alt = alternates(Astro.url);
const en = lang === 'en';
const t = en
  ? {
      home: 'home',
      nav: 'Main',
      links: [
        ['Services', href(lang, '/', '#servicios')],
        ['Process', href(lang, '/', '#proceso')],
        ['Why me', href(lang, '/', '#por-que')],
        ['Diagnostic', href(lang, '/diagnostico')],
        ['FAQ', href(lang, '/', '#faq')],
      ],
      cta: 'Get my diagnostic',
    }
  : {
      home: 'inicio',
      nav: 'Principal',
      links: [
        ['Servicios', href(lang, '/', '#servicios')],
        ['Proceso', href(lang, '/', '#proceso')],
        ['Por qué', href(lang, '/', '#por-que')],
        ['Diagnóstico', href(lang, '/diagnostico')],
        ['Preguntas', href(lang, '/', '#faq')],
      ],
      cta: 'Pedir diagnóstico',
    };
---

<header class="nav" id="nav">
  <div class="wrap nav__inner">
    <a href={href(lang, '/')} class="nav__brand" aria-label={`${SITE.name} — ${t.home}`}>
      <span class="nav__mark" aria-hidden="true">MM</span>
      <span class="nav__name">Magra <em>MultiMedia</em></span>
    </a>

    <nav class="nav__links" aria-label={t.nav}>
      {t.links.map(([label, link]) => <a href={link}>{label}</a>)}
    </nav>

    <div class="nav__right">
      {
        en ? (
          <a class="nav__lang" href={alt.es} hreflang="es" lang="es" aria-label="Ver en español" data-lang-toggle>
            ES
          </a>
        ) : (
          <a class="nav__lang" href={alt.en} hreflang="en" lang="en" aria-label="View in English" data-lang-toggle>
            EN
          </a>
        )
      }
      <button class="btn nav__cta" type="button" data-open-diagnostico data-source="nav">
        {t.cta}
      </button>
    </div>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    inset-block-start: 0;
    inset-inline: 0;
    z-index: 60;
    transition: background 0.5s var(--ease), border-color 0.5s var(--ease);
    border-block-end: 1px solid transparent;
  }

  .nav.is-stuck {
    background: rgba(11, 11, 12, 0.82);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    border-block-end-color: var(--line-soft);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    min-height: 72px;
  }

  .nav__brand {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    flex-shrink: 0;
  }

  .nav__mark {
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 600;
    letter-spacing: -0.06em;
    background: var(--gold-grad);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .nav__name {
    font-family: var(--font-display);
    font-size: 1.05rem;
    letter-spacing: 0.01em;
    color: var(--text);
  }

  .nav__name em {
    font-style: normal;
    color: var(--gold-light);
  }

  .nav__links {
    display: none;
    gap: 2.1rem;
    font-size: var(--fs-small);
    color: var(--text-dim);
  }

  .nav__links a {
    position: relative;
    transition: color 0.4s var(--ease);
  }

  .nav__links a::after {
    content: '';
    position: absolute;
    inset-block-end: -6px;
    inset-inline: 0;
    height: 1px;
    background: var(--gold);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.5s var(--ease-out);
  }

  .nav__links a:hover {
    color: var(--text);
  }

  .nav__links a:hover::after {
    transform: scaleX(1);
  }

  .nav__right {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }

  .nav__lang {
    background: none;
    border: 1px solid var(--line-soft);
    color: var(--text-dim);
    font-size: var(--fs-micro);
    letter-spacing: 0.12em;
    line-height: 1;
    padding: 0.55rem 0.75rem;
    border-radius: var(--radius);
    cursor: pointer;
    font-family: var(--font-body);
    transition: color 0.4s var(--ease), border-color 0.4s var(--ease);
  }

  .nav__lang:hover,
  .nav__lang:focus-visible {
    color: var(--gold-light);
    border-color: var(--gold);
  }

  .nav__cta {
    display: none;
    padding: 0.75rem 1.3rem;
  }

  @media (min-width: 900px) {
    .nav__links,
    .nav__cta {
      display: flex;
    }
  }
</style>

<script>
  const nav = document.getElementById('nav');
  if (nav) {
    const onScroll = () => nav.classList.toggle('is-stuck', window.scrollY > 24);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }

  // Both languages share section ids, so keep the reader's place on switch.
  document.querySelectorAll<HTMLAnchorElement>('[data-lang-toggle]').forEach((a) =>
    a.addEventListener('click', () => {
      if (window.location.hash) a.href = a.href.split('#')[0] + window.location.hash;
    }),
  );
</script>
